# Pushes the Ceph auth ciphers and the storage (client.admin) key of the
# running cluster to the state described by conf.auth_ciphers and
# conf.keyring.storage.key_type in values.yaml. Both tasks used to run from
# the post-apply job, between its mon upgrade pass and its key rotation
# passes; they run from this job instead, enabled separately with
# manifests.aes_storage_keys, so a release can reconcile the ciphers and the
# storage key without the rest of the post-apply work.

export LC_ALL=C

: "${CLUSTER:=ceph}"
: "${ADMIN_KEYRING:=/etc/ceph/${CLUSTER}.client.admin.keyring}"

# Desired storage key type, taken from `conf.keyring.storage.key_type` in
# values.yaml. The storage key is the client.admin key generated by the
# storage keyring manager job and published in the admin keyring Secret and in
# the rbd storageclass Secrets. An empty value means the storage key check is
# skipped.
DESIRED_STORAGE_KEY_TYPE="{{ .Values.conf.keyring.storage.key_type | default "" }}"

# Desired Ceph auth ciphers, taken from `conf.auth_ciphers` in values.yaml and
# pushed to the running cluster by set_monmap_ciphers below with `ceph mon
# set`. Each key of that map is a monmaptool auth cipher option name without
# the leading dashes, rendered here as the matching monmap field name (hyphens
# replaced by underscores), so any, all or none of the ciphers may be
# configured. The mon start script writes the same options into the monmap it
# bootstraps with `monmaptool --create`.
MONMAP_CIPHER_SPECS=(
{{- range $key, $value := (default dict .Values.conf.auth_ciphers) }}
{{- if $value }}
  {{ printf "%s=%s" (replace "-" "_" $key) $value | quote }}
{{- end }}
{{- end }}
)

{{- $adminSecret := .Values.secrets.keyrings.admin }}
{{- $storageSecret := .Values.storageclass.rbd.parameters.adminSecretName }}
{{- $storageSecretNode := .Values.storageclass.rbd.parameters.adminSecretNameNode }}

{{ include "helm-toolkit.snippets.ceph_key_rotation" . }}

if [[ ! -f /etc/ceph/${CLUSTER}.conf ]]; then
  echo "ERROR- /etc/ceph/${CLUSTER}.conf must exist; get it from your existing mon"
  exit 1
fi

if [[ ! -f ${ADMIN_KEYRING} ]]; then
   echo "ERROR- ${ADMIN_KEYRING} must exist; get it from your existing mon"
   exit 1
fi

# Pick the admin keyring the rest of this job authenticates with. The admin
# keyring Secret is mounted read-only with a subPath, so it is never refreshed
# in this pod: when the storage key was replaced by an earlier run (or by an
# earlier part of this one) the mounted keyring may no longer be accepted by
# the cluster. In that case fall back to the previous keyring published by
# publish_secret_keyring below, so an interrupted storage key replacement is
# repaired by this run instead of failing the job forever. Any later ceph call
# in this job uses ${ADMIN_KEYRING}, which is repointed at the fallback copy.
function select_admin_keyring () {
  if timeout 15 ceph --cluster "${CLUSTER}" --name client.admin \
      --keyring "${ADMIN_KEYRING}" status >/dev/null 2>&1; then
    return 0
  fi

  local previous="" jsonpath_key="ceph\\.client\\.admin\\.keyring\\.previous" fallback=""
  previous=$(kubectl --namespace "${NAMESPACE}" get secret "{{ $adminSecret }}" \
    -o "jsonpath={.data.${jsonpath_key}}" 2>/dev/null || true)
  [[ -n "${previous}" ]] || return 0
  fallback=$(mktemp) || return 0
  if ! printf '%s' "${previous}" | base64 -d > "${fallback}" 2>/dev/null; then
    rm -f "${fallback}"
    return 0
  fi
  # ceph-authtool rejects a keyring whose last line has no newline.
  if [[ -n "$(tail -c 1 "${fallback}")" ]]; then
    printf '\n' >> "${fallback}"
  fi
  if ! timeout 15 ceph --cluster "${CLUSTER}" --name client.admin \
      --keyring "${fallback}" status >/dev/null 2>&1; then
    rm -f "${fallback}"
    return 0
  fi

  echo "WARNING- the admin keyring ${ADMIN_KEYRING} does not authenticate, using the previous keyring kept in Secret {{ $adminSecret }}"
  ADMIN_KEYRING="${fallback}"
}

select_admin_keyring

ceph --cluster ${CLUSTER}  -s

function wait_for_pods() {
  timeout=${2:-1800}
  end=$(date -ud "${timeout} seconds" +%s)
  # Selecting containers with "ceph-mon" name and
  # counting them based on "ready" field.
  count_pods=".items | map(.status.containerStatuses | .[] | \
              select(.name==\"ceph-mon\")) | \
              group_by(.ready) | map({(.[0].ready | tostring): length}) | .[]"
  min_mons="add | if .true >= (.false + .true) \
           then \"pass\" else \"fail\" end"
  while true; do
      # Leave while loop if all mons are ready.
      state=$(kubectl get pods --namespace="${1}" -l component=mon -o json | jq "${count_pods}")
      mon_state=$(jq -s "${min_mons}" <<< "${state}")
      if [[ "${mon_state}" == \"pass\" ]]; then
        break
      fi
      sleep 5

      if [ $(date -u +%s) -gt $end ] ; then
          echo -e "Containers failed to start after $timeout seconds\n"
          kubectl get pods --namespace "${1}" -o wide -l component=mon
          exit 1
      fi
  done
}

# Return 0 only when every mon in the monmap is in the quorum, i.e. no mon is
# down or out of quorum. If no mon can be reached at all, quorum_status fails
# and the quorum is treated as degraded. Restarts must never begin while any
# mon is down: deleting a mon pod on an already degraded quorum can tip it
# below majority and block all cluster I/O.
function wait_for_healthy_quorum () {
  local wait_timeout=${1:-${QUORUM_WAIT_TIMEOUT:-1800}}
  local end=$(date -ud "${wait_timeout} seconds" +%s)
  local all_up=""
  while true; do
      all_up=$(timeout 15 ceph --cluster "${CLUSTER}" --name client.admin --keyring "${ADMIN_KEYRING}" \
          quorum_status --format json 2>/dev/null | \
          jq -e '(.quorum_names | length) == (.monmap.mons | length)' 2>/dev/null) || all_up=""
      if [[ "${all_up}" == "true" ]]; then
        echo "All mons are up and in quorum"
        return 0
      fi
      sleep 5

      if [ $(date -u +%s) -gt $end ] ; then
          echo -e "ERROR- mon quorum failed to reach a healthy state (all mons up) after ${wait_timeout} seconds\n"
          ceph --cluster "${CLUSTER}" -s
          kubectl get pods --namespace "${CEPH_NAMESPACE}" -o wide -l component=mon
          exit 1
      fi
  done
}
function check_ds() {
 for ds in `kubectl get ds --namespace=$CEPH_NAMESPACE -l component=mon --no-headers=true|awk '{print $1}'`
 do
   ds_query=`kubectl get ds -n $CEPH_NAMESPACE $ds -o json|jq -r .status`
   if echo $ds_query |grep -i "numberAvailable" ;then
     currentNumberScheduled=`echo $ds_query|jq -r .currentNumberScheduled`
     desiredNumberScheduled=`echo $ds_query|jq -r .desiredNumberScheduled`
     numberAvailable=`echo $ds_query|jq -r .numberAvailable`
     numberReady=`echo $ds_query|jq -r .numberReady`
     updatedNumberScheduled=`echo $ds_query|jq -r .updatedNumberScheduled`
     ds_check=`echo "$currentNumberScheduled $desiredNumberScheduled $numberAvailable $numberReady $updatedNumberScheduled"| \
       tr ' ' '\n'|sort -u|wc -l`
     if [ $ds_check != 1 ]; then
       echo "Some pods in daemonset $ds are not ready"
       exit
     else
       echo "All pods in deamonset $ds are ready"
     fi
   else
     echo "There are no mons under daemonset $ds"
   fi
 done
}

# Restart every mon pod one at a time, waiting for the quorum after each pod.
# Unlike restart_mons in the post-apply job this ignores
# DISRUPTIVE_MON_RESTART by design: this job must never disrupt the mon quorum.
function restart_mons_serially () {
  # Never begin restarting mons while any mon is down.
  wait_for_healthy_quorum

  mon_pods=`kubectl get po -n $CEPH_NAMESPACE -l component=mon --no-headers | awk '{print $1}'`

  for pod in ${mon_pods}
  do
    if [[ -n "$pod" ]]; then
      echo "Restarting pod $pod"
      kubectl delete pod -n $CEPH_NAMESPACE $pod
    fi
    echo "Waiting for the pod $pod to restart"
    # The pod will not be ready in first 60 seconds. Thus we can reduce
    # amount of queries to kubernetes.
    sleep 60
    wait_for_pods $CEPH_NAMESPACE
    ceph -s
  done
}

# Wait until all ceph-mgr pods are ready again after a restart.
function wait_for_mgr_pods () {
  namespace="$1"
  timeout=${2:-1800}
  end=$(date -ud "${timeout} seconds" +%s)

  while true; do
      if ! kubectl get deployment ceph-mgr --namespace="${namespace}" >/dev/null 2>&1; then
        echo "ceph-mgr deployment not found, skipping wait"
        break
      fi
      desired=`kubectl get deployment ceph-mgr --namespace="${namespace}" -o jsonpath='{.spec.replicas}'`
      ready=`kubectl get pods --namespace="${namespace}" -l component=mgr -o json | \
        jq '[.items[].status.containerStatuses[]? | select(.name=="ceph-mgr") | select(.ready)] | length'`
      if [[ -n "${desired}" ]] && [[ -n "${ready}" ]] && [[ "${ready}" -ge "${desired}" ]]; then
        break
      fi
      sleep 5

      if [ $(date -u +%s) -gt $end ] ; then
          echo -e "ceph-mgr containers failed to start after $timeout seconds\n"
          kubectl get pods --namespace "${namespace}" -o wide -l component=mgr
          exit 1
      fi
  done
}

# Restart every ceph-mgr pod one at a time, waiting for the deployment to
# become ready again after each pod.
function restart_mgrs_serially () {
  # Never begin restarting mgrs while any mon is down.
  wait_for_healthy_quorum

  mgr_pods=`kubectl get po -n $CEPH_NAMESPACE -l component=mgr --no-headers | awk '{print $1}'`

  for pod in ${mgr_pods}
  do
    if [[ -n "$pod" ]]; then
      echo "Restarting pod $pod"
      kubectl delete pod -n $CEPH_NAMESPACE $pod
    fi
    echo "Waiting for the pod $pod to restart"
    # The pod will not be ready in first 60 seconds. Thus we can reduce
    # amount of queries to kubernetes.
    sleep 60
    wait_for_mgr_pods $CEPH_NAMESPACE
    ceph -s
  done
}

# Wait until all ceph-mon-check pods are ready again after a restart.
function wait_for_moncheck_pods () {
  namespace="$1"
  timeout=${2:-1800}
  end=$(date -ud "${timeout} seconds" +%s)

  while true; do
      if ! kubectl get deployment ceph-mon-check --namespace="${namespace}" >/dev/null 2>&1; then
        echo "ceph-mon-check deployment not found, skipping wait"
        break
      fi
      desired=`kubectl get deployment ceph-mon-check --namespace="${namespace}" -o jsonpath='{.spec.replicas}'`
      ready=`kubectl get pods --namespace="${namespace}" -l component=moncheck -o json | \
        jq '[.items[].status.containerStatuses[]? | select(.name=="ceph-mon") | select(.ready)] | length'`
      if [[ -n "${desired}" ]] && [[ -n "${ready}" ]] && [[ "${ready}" -ge "${desired}" ]]; then
        break
      fi
      sleep 5

      if [ $(date -u +%s) -gt $end ] ; then
          echo -e "ceph-mon-check containers failed to start after $timeout seconds\n"
          kubectl get pods --namespace "${namespace}" -o wide -l component=moncheck
          exit 1
      fi
  done
}

# Restart every ceph-mon-check pod one at a time, waiting for the deployment to
# become ready again after each pod. The mon-check pod runs ceph commands with
# the admin keyring mounted from the admin keyring Secret, so it has to be
# restarted along with the mons and the managers to pick up a replaced storage
# key. The wait requires `deployments` read access, granted to this job in
# job-aes-storage-keys.yaml.
function restart_monchecks () {
  # Never begin restarting daemons while any mon is down.
  wait_for_healthy_quorum

  moncheck_pods=`kubectl get po -n $CEPH_NAMESPACE -l component=moncheck --no-headers | awk '{print $1}'`

  for pod in ${moncheck_pods}
  do
    if [[ -n "$pod" ]]; then
      echo "Restarting pod $pod"
      kubectl delete pod -n $CEPH_NAMESPACE $pod
    fi
    echo "Waiting for the pod $pod to restart"
    # The pod will not be ready in first 60 seconds. Thus we can reduce
    # amount of queries to kubernetes.
    sleep 60
    wait_for_moncheck_pods $CEPH_NAMESPACE
    ceph -s
  done
}

# Return 0 when the cluster-side key for <entity> already matches the desired
# key type (a secure key), 1 when the key exists but has the wrong length and
# 2 when the state cannot be determined. Key material is never echoed.
# Usage: entity_key_type_state <entity> <desired-key_type>
function entity_key_type_state () {
  local entity="$1"
  local key_type="$2"
  local expected_length="" current_key="" tmpdir="" rc=0 xtrace=0

  expected_length=$(key_type_length "${key_type}" || true)
  if [[ -z "${expected_length}" || ! -e "${ADMIN_KEYRING}" ]]; then
    return 2
  fi

  tmpdir=$(mktemp -d) || return 2
  [[ "${-}" == *x* ]] && xtrace=1
  # Self-clearing: fires on this function's return, then removes itself so
  # it never runs again inside a later function with stale locals.
  trap '[[ -n "${tmpdir:-}" ]] && rm -rf "${tmpdir}" || true; [[ "${xtrace:-0}" -eq 1 ]] && set -x || true; trap - RETURN' RETURN

  # Set +x for the key handling below: key material must never leak through
  # tracing. The RETURN trap above restores tracing on every return path.
  set +x
  if ! timeout 15 ceph --cluster "${CLUSTER}" --name client.admin --keyring "${ADMIN_KEYRING}" \
      auth get "${entity}" -o "${tmpdir}/entity.keyring" >/dev/null 2>&1; then
    # Entity does not exist yet or the cluster cannot be reached.
    return 2
  fi

  current_key=$(keyring_key "${tmpdir}/entity.keyring" "${entity}" || true)
  if [[ -z "${current_key}" ]]; then
    return 2
  fi
  if [[ "${#current_key}" -ne "${expected_length}" ]]; then
    rc=1
  fi
  return "${rc}"
}

# Normalise a comma-separated cipher list read from stdin: drop spaces and
# empty entries, remove duplicates and sort, so that equivalent lists such as
# "aes,aes256k", "aes256k, aes" and "aes256k,aes,aes256k" all normalise to
# "aes,aes256k" and can be compared with the values from
# conf.auth_ciphers.
# Usage: normalise_ciphers <<< "<ciphers>"
function normalise_ciphers () {
  tr -d ' ' | tr ',' '\n' | sed '/^$/d' | sort -u | paste -sd, -
}

# Echo the ciphers configured for the monmap cipher field <field> in the given
# monmap file, normalised for comparison with conf.auth_ciphers.
# "monmaptool --print" renders auth_allowed_ciphers as a sorted "aes, aes256k"
# list and the scalar cipher fields as a single cipher name. Echoes an empty
# string when the field is absent from the monmap.
# Usage: monmap_cipher_list <monmap-file> <field>
function monmap_cipher_list () {
  local monmap="$1"
  local field="$2"
  monmaptool --print "${monmap}" 2>/dev/null | \
    awk -v pattern="^${field} " '$0 ~ pattern {sub(pattern, ""); print; exit}' | \
    normalise_ciphers
}

# Minimum Ceph versions supporting `ceph mon set` for the monmap auth cipher
# fields (auth_allowed_ciphers, auth_preferred_cipher, auth_service_cipher).
# The CephX auth fixes were backported to Squid 19.2.6 and Tentacle 20.2.4 and
# are present in 21+ (Umbrella and later), while Tentacle 20.2.0-20.2.3 and
# Squid releases before 19.2.6 predate them.
AUTH_CIPHERS_MIN_SQUID="19.2.6"
AUTH_CIPHERS_MIN_TENTACLE="20.2.4"
AUTH_CIPHERS_MIN_NEXT_MAJOR="21.0.0"
# Return 0 when the single Ceph version <version> supports setting the monmap
# auth cipher fields, 1 otherwise. A single linear `version_ge` check is not
# sufficient: 19.2.6+ must be allowed while 20.2.0-20.2.3 must be denied.
# Usage: version_supports_auth_ciphers <version>
function version_supports_auth_ciphers () {
  local ver="$1" major=""
  ver="${ver%%-*}"
  [[ -n "${ver}" ]] || return 1
  if version_ge "${ver}" "${AUTH_CIPHERS_MIN_NEXT_MAJOR}"; then
    return 0
  fi
  major="${ver%%.*}"
  if [[ "${major}" == "20" ]]; then
    version_ge "${ver}" "${AUTH_CIPHERS_MIN_TENTACLE}"
    return $?
  fi
  if [[ "${major}" == "19" ]]; then
    version_ge "${ver}" "${AUTH_CIPHERS_MIN_SQUID}"
    return $?
  fi
  return 1
}

# Verify that every monitor in the quorum reports a Ceph version supporting
# the monmap auth cipher fields (19.2.6+, 20.2.4+, 21+). "ceph mon versions"
# lists the versions of all monitors in quorum. Returns 0 only when the
# quorum is reachable and every reported version meets the minimum. Returns 1
# when the quorum cannot be reached, no versions can be parsed, or any
# monitor is older, so callers skip the auth cipher configuration and retry
# on the next job run.
# Usage: mon_quorum_supports_auth_ciphers
function mon_quorum_supports_auth_ciphers () {
  local versions="" version="" found=0
  versions=$(timeout 15 ceph --cluster "${CLUSTER}" --name client.admin \
    --keyring "${ADMIN_KEYRING}" mon versions 2>/dev/null || true)
  [[ -n "${versions}" ]] || return 1
  for version in $(echo "${versions}" | awk '/version/{print $3}'); do
    found=1
    version_supports_auth_ciphers "${version}" || return 1
  done
  [[ "${found}" -eq 1 ]]
}

# Push every auth cipher configured via conf.auth_ciphers in values.yaml to
# the running cluster with `ceph mon set`. The mon start script already writes
# the same ciphers into the monmap it bootstraps, so this is a no-op for a
# monmap created by a mon started with the current values; without it, a
# monmap carried over from a mon started earlier keeps the legacy aes ciphers
# and the storage key generated below would be a legacy aes key.
# With the ciphers set -- by default auth_allowed_ciphers "aes,aes256k",
# auth_preferred_cipher "aes256k" and auth_service_cipher "aes256k" --
# existing aes keys keep authenticating, while the keys generated below use
# aes256k. `ceph mon set` only exists on releases with CephX auth-cipher
# support, so a quorum which does not understand it is left alone by
# mon_quorum_supports_auth_ciphers below and the configuration is retried on
# the next run. The fields are driven by the MONMAP_CIPHER_SPECS array
# rendered from conf.auth_ciphers, so any, all or none of the ciphers may be
# configured. Best effort: fields already matching the desired value are left
# untouched, and a failure only warns, so the storage key reconciliation below
# still runs and convergence is retried on the next job.
function set_monmap_ciphers () {
  if [[ "${#MONMAP_CIPHER_SPECS[@]}" -eq 0 ]]; then
    echo "No monmap auth ciphers configured, skipping"
    return 0
  fi

  # `ceph mon set` only exists on releases with CephX auth-cipher support
  # (19.2.6+, 20.2.4+, 21+); older quorums are left alone.
  if ! mon_quorum_supports_auth_ciphers; then
    echo "WARNING- mon quorum is not fully running a Ceph release with auth-cipher support (19.2.6+, 20.2.4+, 21+), skipping the monmap auth cipher configuration"
    return 1
  fi

  local monmap="" field="" desired="" current=""
  monmap=$(mktemp) || { echo "WARNING- unable to create a temp file, skipping the monmap auth cipher configuration"; return 1; }
  if ! timeout 15 ceph --cluster "${CLUSTER}" --name client.admin --keyring "${ADMIN_KEYRING}" \
      mon getmap -o "${monmap}" >/dev/null 2>&1; then
    echo "WARNING- unable to read the current monmap, skipping the monmap auth cipher configuration"
    rm -f "${monmap}"
    return 1
  fi

  for spec in "${MONMAP_CIPHER_SPECS[@]}"; do
    field="${spec%%=*}"
    desired="${spec#*=}"
    if [[ -z "${desired}" ]]; then
      echo "No desired monmap ${field} configured, skipping"
      continue
    fi
    current=$(monmap_cipher_list "${monmap}" "${field}")
    if [[ "${current}" == "$(normalise_ciphers <<< "${desired}")" ]]; then
      echo "Monmap ${field} is already set to ${current}, skipping"
      continue
    fi
    echo "Setting the monmap ${field} to ${desired}"
    timeout 30 ceph --cluster "${CLUSTER}" --name client.admin --keyring "${ADMIN_KEYRING}" \
      mon set "${field}" "${desired}" || \
      echo "WARNING- failed to set the monmap ${field}, continuing"
  done

  rm -f "${monmap}"
}

# Return 0 when the storage (client.admin) key of the cluster has to be
# replaced with a newly generated key of DESIRED_STORAGE_KEY_TYPE, 1 when it
# already matches (or when no storage key type is configured) and 2 when the
# state cannot be determined. Key material is never echoed.
function storage_key_needs_replacement () {
  local rc=0
  [[ -n "${DESIRED_STORAGE_KEY_TYPE}" ]] || return 1
  entity_key_type_state "client.admin" "${DESIRED_STORAGE_KEY_TYPE}" || rc=$?
  [[ "${rc}" -eq 1 ]]
}

# Echo the base64 decoded value stored under <data-key> in the Kubernetes
# Secret <secret-name>, or nothing when the Secret or the key is missing.
# Requires the NAMESPACE environment variable.
# Usage: secret_data_key <secret-name> <data-key>
function secret_data_key () {
  local secret_name="$1" data_key="$2" jsonpath_key="" encoded=""
  # kubectl's JSONPath re-parses bracket-quoted keys as field paths, so the dots
  # in data keys such as "ceph.client.admin.keyring" must be escaped, as
  # elsewhere in this repo (see secret_keyring in the key rotation snippet).
  jsonpath_key="${data_key//./\\.}"
  encoded=$(kubectl --namespace "${NAMESPACE}" get secret "${secret_name}" \
    -o "jsonpath={.data.${jsonpath_key}}" 2>/dev/null || true)
  [[ -n "${encoded}" ]] || return 1
  printf '%s' "${encoded}" | base64 -d 2>/dev/null
}

# Return 0 when one of the rbd storageclass Secrets does not hold a key of
# DESIRED_STORAGE_KEY_TYPE. A missing key counts as a mismatch, so a Secret
# left behind by an interrupted run is repaired as well.
function storage_class_key_needs_replacement () {
  local expected="" secret_name="" current=""
  expected=$(key_type_length "${DESIRED_STORAGE_KEY_TYPE}" || true)
  [[ -n "${expected}" ]] || return 1
  for secret_name in "{{ $storageSecret }}" "{{ $storageSecretNode }}"; do
    [[ -n "${secret_name}" ]] || continue
    current=$(secret_data_key "${secret_name}" "key" || true)
    if [[ -z "${current}" || "${#current}" -ne "${expected}" ]]; then
      return 0
    fi
  done
  return 1
}

# Replace the "key" and "userKey" fields of a kubernetes.io/rbd storageclass
# Secret with <key>. Requires the NAMESPACE environment variable.
# Usage: patch_rbd_storage_key <secret-name> <key>
function patch_rbd_storage_key () {
  local secret_name="$1" key="$2" encoded=""
  encoded=$(printf '%s' "${key}" | base64 -w0)
  kubectl --namespace "${NAMESPACE}" patch secret "${secret_name}" --type merge \
    -p "{\"data\":{\"key\":\"${encoded}\",\"userKey\":\"${encoded}\"}}"
}

# Publish <keyring-file> in the Kubernetes Secret <secret-name> under
# <data-key>, keeping the keyring currently stored there under
# "<data-key>.previous". The preserved keyring is the recovery path for the
# storage key replacement below: the Secret mounted into this pod is read-only
# and is never refreshed, so a run interrupted after the cluster was given a
# new key would otherwise have no way to authenticate on the next run.
# Requires the NAMESPACE environment variable.
# Usage: publish_secret_keyring <secret-name> <data-key> <keyring-file>
function publish_secret_keyring () {
  local secret_name="$1" data_key="$2" keyring_file="$3"
  local previous_key="${data_key}.previous" jsonpath_key=""
  local encoded="" current="" payload=""
  # Read the keyring being replaced, which becomes the recovery copy.
  jsonpath_key="${data_key//./\\.}"
  encoded=$(base64 < "${keyring_file}" | tr -d '\n')
  if [[ -z "${encoded}" ]]; then
    echo "WARNING- unable to encode ${keyring_file} for Secret ${secret_name}, skipping the patch"
    return 1
  fi
  current=$(kubectl --namespace "${NAMESPACE}" get secret "${secret_name}" \
    -o "jsonpath={.data.${jsonpath_key}}" 2>/dev/null || true)
  payload="{\"data\":{\"${data_key}\":\"${encoded}\""
  if [[ -n "${current}" && "${current}" != "${encoded}" ]]; then
    payload="${payload},\"${previous_key}\":\"${current}\""
  fi
  payload="${payload}}}"
  kubectl --namespace "${NAMESPACE}" patch secret "${secret_name}" \
    --type merge -p "${payload}"
}

# Return 0 when conf.auth_ciphers does not configure an auth_allowed_ciphers
# list, or when the list it configures allows DESIRED_STORAGE_KEY_TYPE. The
# ciphers are only configurable on releases with the monmap auth cipher fields
# and the running monmap is verified separately by
# storage_key_type_allowed_in_monmap, so an absent configuration is not treated
# as a rejection here.
function storage_key_type_allowed_in_values () {
  local spec="" field=""
  for spec in "${MONMAP_CIPHER_SPECS[@]}"; do
    field="${spec%%=*}"
    [[ "${field}" == "auth_allowed_ciphers" ]] || continue
    if [[ ",$(normalise_ciphers <<< "${spec#*=}")," != *",${DESIRED_STORAGE_KEY_TYPE},"* ]]; then
      return 1
    fi
  done
  return 0
}

# Return 0 when the monmap of the running cluster allows
# DESIRED_STORAGE_KEY_TYPE to authenticate, i.e. when a key of that type may be
# installed. Returns 1 when the cipher is not allowed or the monmap cannot be
# read: a monmap created by a release which only allows aes256k (the default of
# `monmaptool --create` on 20.2.4) would reject an aes key, and installing one
# would lock every consumer of the storage key out of the cluster.
function storage_key_type_allowed_in_monmap () {
  local monmap="" allowed=""
  [[ -n "${DESIRED_STORAGE_KEY_TYPE}" ]] || return 1
  monmap=$(mktemp) || return 1
  if ! timeout 15 ceph --cluster "${CLUSTER}" --name client.admin --keyring "${ADMIN_KEYRING}" \
      mon getmap -o "${monmap}" >/dev/null 2>&1; then
    echo "WARNING- unable to read the current monmap, unable to confirm the monmap auth cipher configuration"
    rm -f "${monmap}"
    return 1
  fi
  allowed=$(monmap_cipher_list "${monmap}" "auth_allowed_ciphers")
  rm -f "${monmap}"
  if [[ -z "${allowed}" ]]; then
    echo "WARNING- the monmap does not report auth_allowed_ciphers, unable to confirm the monmap auth cipher configuration"
    return 1
  fi
  [[ ",${allowed}," == *",${DESIRED_STORAGE_KEY_TYPE},"* ]]
}

# Replace the storage (client.admin) key with a newly generated key of
# DESIRED_STORAGE_KEY_TYPE. `ceph-authtool --key-type` picks the key type
# explicitly, so the storage clients which cannot use aes256k can be given a
# legacy aes key again. The current keyring is fetched first so the entity keeps its caps and
# auid, the new keyring is published in the admin keyring Secret and in both
# rbd storageclass Secrets, and only then installed in the cluster: until that
# import the cluster still accepts the previous key, so a run interrupted in
# between leaves every daemon working and is repaired by
# select_admin_keyring on the next run. The job authenticates with the new
# keyring afterwards, since the Secret mounted into this pod is not refreshed
# until the pod is recreated.
function replace_storage_key () {
  local tmpdir="" new_key="" current_key="" new_keyring=""
  tmpdir=$(mktemp -d) || { echo "WARNING- unable to create a temp dir, skipping the storage key replacement"; return 1; }

  if ! timeout 15 ceph --cluster "${CLUSTER}" --name client.admin --keyring "${ADMIN_KEYRING}" \
      auth get client.admin -o "${tmpdir}/current.keyring" >/dev/null 2>&1; then
    echo "WARNING- unable to read the current client.admin keyring, skipping the storage key replacement"
    rm -rf "${tmpdir}"
    return 1
  fi
  current_key=$(keyring_key "${tmpdir}/current.keyring" "client.admin" || true)
  if [[ -z "${current_key}" ]]; then
    echo "WARNING- unable to read the current client.admin key, skipping the storage key replacement"
    rm -rf "${tmpdir}"
    return 1
  fi

  if ! new_key=$(ceph-authtool --key-type="${DESIRED_STORAGE_KEY_TYPE}" --gen-print-key); then
    echo "WARNING- unable to generate a new ${DESIRED_STORAGE_KEY_TYPE} storage key, skipping the storage key replacement"
    rm -rf "${tmpdir}"
    return 1
  fi
  new_keyring="${tmpdir}/admin.keyring"
  # Build the new keyring by hand: `ceph-authtool --add-key` replaces the
  # whole entity entry, dropping the caps and the auid, which would leave the
  # admin key without its capabilities.
  {
    echo "[client.admin]"
    printf '\tkey = %s\n' "${new_key}"
    grep -E '^[[:space:]]*(auid|caps) ' "${tmpdir}/current.keyring" || true
  } > "${new_keyring}"
  if ! ceph-authtool -l "${new_keyring}" >/dev/null; then
    echo "WARNING- the new client.admin keyring is not valid, skipping the storage key replacement"
    rm -rf "${tmpdir}"
    return 1
  fi

  if ! publish_secret_keyring "{{ $adminSecret }}" "ceph.client.admin.keyring" "${new_keyring}"; then
    echo "WARNING- unable to publish the new storage key in Secret {{ $adminSecret }}, skipping the storage key replacement"
    rm -rf "${tmpdir}"
    return 1
  fi
  if ! patch_rbd_storage_key "{{ $storageSecret }}" "${new_key}"; then
    echo "WARNING- unable to publish the new storage key in Secret {{ $storageSecret }}, skipping the storage key replacement"
    rm -rf "${tmpdir}"
    return 1
  fi
  if [[ "{{ $storageSecretNode }}" != "{{ $storageSecret }}" ]] && \
     ! patch_rbd_storage_key "{{ $storageSecretNode }}" "${new_key}"; then
    echo "WARNING- unable to publish the new storage key in Secret {{ $storageSecretNode }}, skipping the storage key replacement"
    rm -rf "${tmpdir}"
    return 1
  fi

  # The previous key stops being accepted here.
  if ! timeout 30 ceph --cluster "${CLUSTER}" --name client.admin --keyring "${ADMIN_KEYRING}" \
      auth import -i "${new_keyring}"; then
    echo "WARNING- unable to install the new storage key in the cluster, restoring the previous key in the Secrets"
    patch_secret_keyring "{{ $adminSecret }}" "ceph.client.admin.keyring" "${tmpdir}/current.keyring" >/dev/null 2>&1 || true
    patch_rbd_storage_key "{{ $storageSecret }}" "${current_key}" >/dev/null 2>&1 || true
    [[ "{{ $storageSecretNode }}" == "{{ $storageSecret }}" ]] || \
      patch_rbd_storage_key "{{ $storageSecretNode }}" "${current_key}" >/dev/null 2>&1 || true
    rm -rf "${tmpdir}"
    return 1
  fi

  if ! cp -f "${new_keyring}" /tmp/ceph.client.admin.keyring; then
    echo "WARNING- unable to copy the new admin keyring to /tmp, continuing with the mounted admin keyring"
    rm -rf "${tmpdir}"
    return 1
  fi
  rm -rf "${tmpdir}"
  ADMIN_KEYRING=/tmp/ceph.client.admin.keyring
  echo "Replaced the storage key with a new ${DESIRED_STORAGE_KEY_TYPE} key"
  return 0
}

# Return 0 when the admin keyring this job uses authenticates, i.e. when the
# key installed by replace_storage_key is accepted by the cluster.
function verify_storage_key () {
  timeout 15 ceph --cluster "${CLUSTER}" --name client.admin --keyring "${ADMIN_KEYRING}" \
    status >/dev/null 2>&1
}

# Reconcile the storage (client.admin) key with the storage key type
# configured via conf.keyring.storage.key_type. That key is the one the rbd
# storageclass authenticates with, so a key left behind by an earlier release
# (e.g. an aes256k key, which Ceph CSI cannot use to map RBDs on pre-7.0
# kernels) is replaced by a freshly generated key of the configured type, and
# every pod mounting it afterwards -- the mons, the managers and the
# ceph-mon-check pod -- is restarted to pick it up.
#
# The ciphers from conf.auth_ciphers are applied to the running cluster and
# verified before any key is generated: a monmap which does not allow the
# configured type would reject the new key, and replacing the admin key in that
# case would lock every consumer of the storage key out of the cluster, so the
# replacement is skipped (and retried on the next job run) instead.
#
# Runs once the whole quorum has finished upgrading, so the `ceph mon set`
# calls above succeed; a quorum which does not understand them is detected by
# mon_quorum_supports_auth_ciphers, which then leaves the replacement to the
# next run. A converged cluster, the common case, does nothing.
function reconcile_storage_key () {
  if [[ -z "${DESIRED_STORAGE_KEY_TYPE}" ]]; then
    echo "No desired storage key type configured, skipping the storage key check"
    return 0
  fi

  if ! storage_key_needs_replacement && ! storage_class_key_needs_replacement; then
    echo "The storage key is already of type ${DESIRED_STORAGE_KEY_TYPE}, skipping the storage key replacement"
    return 0
  fi

  set_monmap_ciphers
  if ! storage_key_type_allowed_in_values; then
    echo "WARNING- conf.auth_ciphers does not allow the ${DESIRED_STORAGE_KEY_TYPE} storage key, skipping the storage key replacement"
    return 0
  fi
  if ! storage_key_type_allowed_in_monmap; then
    # set_monmap_ciphers is best effort: give it a second chance before
    # giving up on the replacement.
    set_monmap_ciphers
    if ! storage_key_type_allowed_in_monmap; then
      echo "WARNING- the monmap auth_allowed_ciphers of the running cluster does not allow the ${DESIRED_STORAGE_KEY_TYPE} storage key, skipping the storage key replacement"
      return 0
    fi
  fi

  if ! replace_storage_key; then
    echo "WARNING- the ${DESIRED_STORAGE_KEY_TYPE} storage key was not replaced, the next aes-storage-keys run retries it"
    return 1
  fi

  if ! verify_storage_key; then
    echo "WARNING- the new ${DESIRED_STORAGE_KEY_TYPE} storage key does not authenticate, not restarting the pods which use it"
    return 1
  fi

  echo "The storage key is now of type ${DESIRED_STORAGE_KEY_TYPE}, restarting the pods which use it"
  restart_mons_serially
  check_ds
  restart_mgrs_serially
  restart_monchecks
  return 0
}

wait_for_pods $CEPH_NAMESPACE

# Push the configured auth ciphers to the monmap first: a monmap created by an
# older Ceph release carries the legacy aes cipher as its preferred cipher, so
# the storage key generated below would be an aes key rather than the
# configured one. Setting the ciphers keeps the existing aes keys working while
# letting the key reconciliation below produce aes256k keys.
set_monmap_ciphers

# Reconcile the storage (client.admin) key with the type configured via
# conf.keyring.storage.key_type. The ciphers above are applied first and then
# verified to allow that type, so a key generated for the storage clients is one
# the cluster accepts. A key of a different type -- e.g. an aes256k key written
# by an earlier release, which Ceph CSI cannot use to map RBDs on pre-7.0
# kernels -- is replaced and the mon, mgr and ceph-mon-check pods mounting it
# are restarted to pick it up.
reconcile_storage_key
